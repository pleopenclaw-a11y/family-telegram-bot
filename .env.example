# Telegram
TELEGRAM_BOT_TOKEN=xxx

# 9arm OpenAI-compatible gateway
NINEARM_BASE_URL=https://gateway.9arm.co/v1
NINEARM_API_KEY=xxx

# Chat model routing
NINEARM_PRIMARY_MODEL=deepseek-v4-flash-0731
NINEARM_FALLBACK_MODEL=qwen3.8-27b-fp8

# Hosted embeddings only; fill after /v1/models confirms the exact model name.
# Do not use local embeddings.
NINEARM_EMBEDDING_MODEL=

# Persistence (to be wired in next implementation step)
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Telegram behavior
TELEGRAM_GROUP_ID=
TELEGRAM_POLLING_ENABLED=true

# Optional API protection. When set, every API route except /api/healthz
# requires Authorization: Bearer <token>. Keep this value server-side.
FAMILY_BOARD_API_TOKEN=
FAMILY_BOARD_ALLOWED_ORIGIN=https://web-fawn-two-89.vercel.app
